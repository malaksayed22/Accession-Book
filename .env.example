# Optional. Copy to .env (never commit .env) to override the defaults below.
# The server layer is a mock (see src/server/env.ts), so no database or secrets are needed.

# Public origin of the app. On Vercel, set this to the deployment URL.
APP_URL=http://localhost:3000

# Laboratory time zone: regulatory days and reporting periods are calendar days here.
LAB_TIMEZONE=America/Toronto
